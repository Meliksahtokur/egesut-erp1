[{"json_build_object":{"alinma":"2026-10-17T19:42:47.516708+00:00","md5":"28b209abcbc0927629e85d2dcf690f01","functiondef":"CREATE OR REPLACE FUNCTION public._vaka_ovsync_mu(p_case_id uuid)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\n  SELECT EXISTS (\n    SELECT 1 FROM public.cases c\n     WHERE c.id = p_case_id\n       AND (c.protocol_family = 'OVSYNC'\n            OR (c.protocol_family IS NULL\n                AND (EXISTS (SELECT 1 FROM public.sablon_hastalik_eslem e\n                              JOIN public.tedavi_sablonu t ON t.id = e.sablon_id\n                             WHERE e.disease_id = c.disease_id AND t.protokol_ailesi = 'OVSYNC')\n                     OR EXISTS (SELECT 1 FROM public.gorev_log g\n                                 WHERE g.kaynak LIKE 'TEDAVI_SABLON_TOHUMLAMA:' || c.id::text || ':%')))));\n$function$\n","acl":"postgres=X/postgres,service_role=X/postgres","sm_max":"20261013000005","sm_sayi":165,"ovsync_true":["02f61ebd-51ce-4263-8863-38ea2f731f7f","03b10e2a-1800-43b0-864d-c392329727b3","05190e0a-fdd6-4897-9f17-f29e98603d14","0a23bc51-a675-488f-966f-c9af82563505","0eefbc18-8a55-41bb-8401-5adf332d5abe","170465fd-d67c-444b-95a6-a141f54aed88","19febaa1-ff69-44c9-84ff-a08a64652dc7","1b5c2a83-461d-445e-ae25-33db59b4266a","1d177526-44bf-49e1-98b7-9c4630e8f803","1e7652ce-998a-423e-9f12-f74ef002f183","1e9b93a9-3c1c-436f-a865-b284f62cbddc","1f03f184-8ace-4d07-be11-775928f43615","22b64b3b-055d-42b2-8002-bf917d7f060b","232e7f7d-1740-4f50-b9a9-702f05c6fc03","25a638aa-1fa3-4925-9c6a-4362d6ff8e1b","28cab02f-7180-4cf4-ae88-3157876547d8","3681c010-b29b-4a99-b582-e9e53928e544","375a8d6a-3619-4dc8-9faa-7dd8828966c5","37b98c0c-fb4f-410d-9d3a-c7aeac5cc435","3a9606ec-2bd2-4ccc-9256-d6e27287a47b","3e6ce4e9-0b03-4394-9111-99379afd37f6","41257751-9939-47b8-a6bc-9d0c8ae0df1f","4600ec46-cc9c-4113-af22-e82bea5b2729","46ad7840-0754-4f4d-a128-980d51be2965","51adfd85-f0cd-4de4-92f2-4b807f7634ad","6