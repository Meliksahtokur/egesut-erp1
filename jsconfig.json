{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "checkJs": false,
    "allowJs": true,
    "allowUmdGlobalAccess": true,
    "noEmit": true,
    "lib": ["ES2021", "DOM", "DOM.Iterable"]
  },
  "include": ["js/**/*.js", "types/**/*.d.ts"],
  "exclude": ["node_modules", "tests", "supabase/functions"]
}
