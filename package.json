{
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "fast-check": "^4.8.0",
    "supabase": "^2.76.16"
  },
  "name": "egesut-erp1",
  "version": "1.0.0",
  "description": "",
  "main": "playwright.config.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report tests/report",
    "test:unit": "node --test tests/unit/*.test.js",
    "serve:local": "python3 -m http.server 8080",
    "test:local": "PLAYWRIGHT_BASE_URL=http://127.0.0.1:8080/ playwright test",
    "test:demo": "PLAYWRIGHT_DEMO_MODE=1 playwright test",
    "test:docker": "docker run --rm -v \"$PWD\":/work -w /work mcr.microsoft.com/playwright:v1.58.2-noble npx playwright test",
    "test:docker:demo": "docker run --rm -e PLAYWRIGHT_DEMO_MODE=1 -v \"$PWD\":/work -w /work mcr.microsoft.com/playwright:v1.58.2-noble npx playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meliksahtokur/egesut-erp1.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/meliksahtokur/egesut-erp1/issues"
  },
  "homepage": "https://github.com/meliksahtokur/egesut-erp1#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.28.0",
    "@octokit/rest": "^22.0.1",
    "@supabase/supabase-js": "^2.100.1",
    "node-fetch": "^3.3.2",
    "zod": "^4.3.6"
  }
}
