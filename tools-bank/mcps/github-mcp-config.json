{
  "name": "github-mcp",
  "description": "GitHub repository automation and management",
  "version": "1.0.0",
  "server": {
    "command": "claude-code",
    "args": ["--mcp-server", "github"],
    "env": {
      "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
    }
  },
  "capabilities": [
    "repository_management",
    "issue_tracking",
    "pull_request_automation",
    "code_search",
    "branch_management",
    "commit_operations"
  ],
  "tools": [
    "create_repository",
    "create_issue",
    "create_pull_request",
    "add_issue_comment",
    "get_file_contents",
    "search_code",
    "list_commits",
    "merge_pull_request"
  ],
  "intelligence_integration": {
    "memory_context": true,
    "semantic_search": true,
    "autonomous_workflows": true
  },
  "examples": [
    "Auto-create issues from code analysis",
    "Memory-guided PR descriptions",
    "Intelligent code search with context"
  ]
}