{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egesut.invalid/harness/decision.schema.json",
  "title": "EgeSut Harness Decision",
  "type": "object",
  "required": ["id", "date", "status", "head", "superseded_by"],
  "properties": {
    "id": {"type": "string", "pattern": "^D-[0-9]{8}-[A-Z0-9][A-Z0-9-]*$"},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "status": {"enum": ["proposed", "accepted", "superseded", "rejected"]},
    "head": {"type": ["string", "null"], "pattern": "^[0-9a-f]{7,40}$"},
    "superseded_by": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
