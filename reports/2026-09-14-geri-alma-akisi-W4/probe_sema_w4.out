== 3. islem_log triggerlar ==
           tgname           |                                                                           pg_get_triggerdef                                                                           
----------------------------+-----------------------------------------------------------------------------------------------------------------------------------------------------------------------
 trg_islem_log_degisim_txid | CREATE TRIGGER trg_islem_log_degisim_txid BEFORE INSERT ON public.islem_log FOR EACH ROW WHEN ((new.degisim_txid IS NULL)) EXECUTE FUNCTION _islem_log_degisim_txid()
 trg_islem_log_immutable    | CREATE TRIGGER trg_islem_log_immutable BEFORE DELETE OR UPDATE ON public.islem_log FOR EACH ROW EXECUTE FUNCTION _islem_log_immutable_guard()
(2 satır)

