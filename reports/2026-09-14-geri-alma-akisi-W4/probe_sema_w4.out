== 6. kapsam tabloları (surum_gizli._kapsamda gövdesinden) ==
                                   prosrc                                    
-----------------------------------------------------------------------------
                                                                            +
   SELECT EXISTS (SELECT 1 FROM pg_trigger                                  +
                   WHERE tgrelid = to_regclass(format('public.%I', p_tablo))+
                     AND tgname = 'trg_degisim_log');                       +
 
(1 satır)

